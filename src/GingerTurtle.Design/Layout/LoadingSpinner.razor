<div class="spinner-wrapper">
    <section><span class="loader-38"> </span></section>
</div>

@if (!string.IsNullOrEmpty(LoadingText))
{
    <div class="hero">
        @LoadingText
    </div>
}


@code {

    [Parameter] public string LoadingText { get; set; }

    [Parameter] public ElementSize TextSize { get; set; } = ElementSize.Large;

    [Parameter] public ElementSize SpinnerSize { get; set; } = ElementSize.Large;

}