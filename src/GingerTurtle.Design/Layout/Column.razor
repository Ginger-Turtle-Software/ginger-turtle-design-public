@using System.Text

<div class="col @GetDeviceSizeCss()">
    <div class="col-content @GetHorizontalLayoutCss() @GetVerticalLayoutCss()">
        @ChildContent
    </div>
</div>

@code {

    [Parameter] 
    public ColumnSize DesktopSize { get; set; } = ColumnSize.ColAuto;

    [Parameter]
    public ColumnSize MobileSize { get; set; } = ColumnSize.Col100;
    
    [Parameter]
    public PaddingSize Padding { get; set; } = PaddingSize.None;
    
    [Parameter]
    public HorizontalPosition HorizontalLayout { get; set; } = HorizontalPosition.Left;
    
    [Parameter] 
    public VerticalPosition VerticalLayout { get; set; } = VerticalPosition.Centre;

    [Parameter] 
    public string CssClass { get; set; } = "";
    
    [Parameter]
    public RenderFragment ChildContent { get; set; }
    
    private string GetDeviceSizeCss()
    {
        var builder = new StringBuilder();
        builder.Append($"{MobileSize.GetMobileCss()} ");
        builder.Append($"{DesktopSize.GetDesktopCss()} ");
        builder.Append($"{Padding.GetCss()} ");
        builder.Append($"{CssClass} ");
        return builder.ToString();
    }

    private string GetHorizontalLayoutCss() => 
        HorizontalLayout switch
        {
            HorizontalPosition.Left => "col-horizontal-left",
            HorizontalPosition.Centre => "col-horizontal-centre",
            HorizontalPosition.Right => "col-horizontal-right",
            _ => ""
        };
    
    private string GetVerticalLayoutCss() => 
        VerticalLayout switch
        {
            VerticalPosition.Top => "col-vertical-top",
            VerticalPosition.Centre => "col-vertical-centre",
            VerticalPosition.Bottom => "col-vertical-bottom",
            _ => ""
        };
    
}